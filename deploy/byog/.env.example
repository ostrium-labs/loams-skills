# Company BYOG settings. Copy the full upstream deploy/release/.env.example for
# every option; this file lists the ones a company install must decide.
# Never commit the real .env.

# --- Release ---------------------------------------------------------------
LOAMS_REGISTRY=ghcr.io/ostrium-labs
LOAMS_VERSION=0.1.1
COMPOSE_PROFILES=

# --- Ground ----------------------------------------------------------------
# Company bucket, with versioning on. Cloud identity, not static keys.
LOAMS_BUCKET=s3://CHANGE_ME
# AWS_REGION is read from the instance role, or set it without keys.
# AWS_REGION=us-east-1

# --- Reachability ----------------------------------------------------------
# The only way in is the company tailnet. No inbound cloud rule.
TS_AUTHKEY=
TS_HOSTNAME=loams
TS_SERVE_MODE=https
LOAMS_TAILSCALE_ALLOWED_USERS=

# --- Auth ------------------------------------------------------------------
# tailscale is the simplest first install; oidc for the company IdP; apikey for
# services and CI. Do not use off outside a loopback test.
LOAMS_AUTH_MODE=tailscale
LOAMS_SETUP_TOKEN=
LOAMS_OIDC_ISSUER=https://auth.example.com
LOAMS_OIDC_AUDIENCE=loams
LOAMS_OIDC_ALLOWED_EMAILS=

# --- Storage ---------------------------------------------------------------
LOAMS_LISTEN=127.0.0.1:8080
LOAMS_TAILSCALE_LISTEN=127.0.0.1:7781
LOAMS_DURABLE_STORE=
LOAMS_POSTGRES_COMPOSE=../loams-postgres-dev/compose.yaml
RUST_LOG=info
